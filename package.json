{
  "name": "v3cell-web",
  "version": "1.0.0",
  "private": true,
  "description": "V3Cell research website and interactive manuscript figure explorer",
  "scripts": {
    "check": "node -e \"const fs=require('fs'),cp=require('child_process');for(const f of fs.readdirSync('dist'))if(f.endsWith('.js'))cp.execFileSync(process.execPath,['--check','dist/'+f],{stdio:'inherit'})\" && python scripts/check.py",
    "serve": "python -m http.server 3000 --directory dist"
  }
}
